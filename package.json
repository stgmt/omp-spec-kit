{
  "name": "omp-spec-kit-repository",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "node scripts/build-plugin.mjs",
    "verify": "npm run check:no-root-specs && node scripts/verify-marketplace.mjs && node scripts/verify-package.mjs && npm run check:spec-port && npm run check:blast && npm run check:mutations",
    "check:no-root-specs": "node scripts/check-no-root-specs.mjs",
    "check:spec-corpus": "node scripts/check-spec-corpus.mjs",
    "check:corpus:remote": "node scripts/check-corpus-via-mcp.mjs",
    "check:spec-port": "node scripts/check-spec-port.mjs",
    "dogfood:mcp": "node scripts/dogfood-mcp.mjs",
    "dogfood:mcp:candidate": "node scripts/dogfood-mcp.mjs",
    "test:bdd": "bash scripts/docker-bdd.sh",
    "test:bdd:omp-discovery": "bash scripts/docker-bdd.sh --tags '@id:SCEN-mri-active-project-manager-receipt'",
    "test": "npm run build && npm run verify && npm run dogfood:mcp:candidate && npm run test:safe-authoring && npm run test:staged && npm run test:unit && npm run test:bdd",
    "test:safe-authoring": "npx cucumber-js tests/features/safe-authoring.feature --import tests/step-definitions/safe-authoring.steps.mjs --tags @safe-authoring --format progress --force-exit",
    "test:tool-e2e": "npx cucumber-js tests/features/staged-mcp.feature --import tests/step-definitions/staged-mcp.steps.mjs --tags @tool-e2e --format progress --force-exit",
    "test:staged": "npx cucumber-js tests/features/staged-mcp.feature --import tests/step-definitions/staged-mcp.steps.mjs --format progress --force-exit",
    "test:unit": "node --test tests/spec-graph-sync/serve.test.js tests/spec-graph-sync/sync.test.js tests/spec-graph-sync/store.test.js tests/spec-graph-sync/sweep.test.js tests/spec-graph-sync/writeback.test.js tests/authoring-elicitation-edges.test.mjs tests/authoring-task-status.test.mjs tests/authoring-secrets.test.mjs tests/kernel-fields.test.mjs tests/roadmap-assemble.test.mjs tests/unit/service/mounts.test.mjs tests/unit/service/tenants-claims.test.mjs tests/unit/service/git-auth.test.mjs",
    "test:service": "node --experimental-sqlite --test tests/service/integration.test.mjs tests/service/http.test.mjs tests/service/writepath.test.mjs tests/service/task6.test.mjs",
    "test:e2e:auth": "node tests/e2e/run-live.mjs",
    "service:start": "node --experimental-sqlite src/service/index.js",
    "test:release-archive": "node scripts/smoke-release-archive.mjs",
    "test:release-integrity": "npx cucumber-js tests/features/release-evidence.feature --import tests/step-definitions/mcp-release-integrity.steps.mjs --tags @mcp-release-integrity --format progress --force-exit",
    "release:preflight": "node scripts/release-preflight.mjs",
    "docs:mcp": "node scripts/generate-mcp-docs.mjs",
    "check:blast": "node scripts/measure-mcp-tool-blast.mjs",
    "check:mutations": "node scripts/check-tool-surface-mutations.mjs"
  },
  "devDependencies": {
    "@cucumber/cucumber": "13.2.1",
    "playwright-core": "1.63.0"
  },
  "dependencies": {
    "@jetbrains/youtrack-apps-tools": "^1.0.3",
    "@modelcontextprotocol/sdk": "1.30.0",
    "express": "5.2.1"
  }
}
