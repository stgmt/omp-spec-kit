{
  "name": "omp-spec-kit-repository",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "node scripts/build-plugin.mjs",
    "verify": "node scripts/verify-marketplace.mjs && node scripts/verify-package.mjs && npm run check:spec-corpus && npm run check:spec-port && npm run check:blast && npm run check:mutations",
    "check:spec-corpus": "node scripts/check-spec-corpus.mjs",
    "check:spec-port": "node scripts/check-spec-port.mjs",
    "dogfood:mcp": "node scripts/dogfood-mcp.mjs",
    "dogfood:mcp:candidate": "node scripts/dogfood-mcp.mjs",
    "test:bdd": "bash scripts/docker-bdd.sh",
    "test:bdd:omp-discovery": "bash scripts/docker-bdd.sh --tags '@id:SCEN-mri-active-project-manager-receipt or @id:SCEN-mri-missing-payload-refusal'",
    "test": "npm run build && npm run verify && npm run dogfood:mcp:candidate && npm run test:safe-authoring && npm run test:staged && npm run test:bdd",
    "test:safe-authoring": "npx cucumber-js tests/features/safe-authoring.feature --import tests/step-definitions/safe-authoring.steps.mjs --tags @safe-authoring --format progress --force-exit",
    "test:tool-e2e": "npx cucumber-js tests/features/staged-mcp.feature --import tests/step-definitions/staged-mcp.steps.mjs --tags @tool-e2e --format progress --force-exit",
    "test:staged": "npx cucumber-js tests/features/staged-mcp.feature --import tests/step-definitions/staged-mcp.steps.mjs --format progress --force-exit",
    "test:release-archive": "node scripts/smoke-release-archive.mjs",
    "test:release-integrity": "npx cucumber-js tests/features/release-evidence.feature --tags @mcp-release-integrity --format progress",
    "release:preflight": "node scripts/release-preflight.mjs",
    "docs:mcp": "node scripts/generate-mcp-docs.mjs",
    "check:blast": "node scripts/measure-mcp-tool-blast.mjs",
    "check:mutations": "node scripts/check-tool-surface-mutations.mjs"
  },
  "devDependencies": {
    "@cucumber/cucumber": "13.2.1"
  }
}
