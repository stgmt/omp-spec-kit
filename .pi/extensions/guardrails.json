{
  "version": "0.18.0",
  "enabled": true,
  "features": {
    "policies": true,
    "permissionGate": true,
    "pathAccess": false,
    "rootArtifacts": true
  },
  "rootArtifacts": {
    "enabled": true,
    "mode": "extend",
    "allow": [
      ".dockerignore",
      ".gitattributes",
      ".gitignore",
      "CHANGELOG.md",
      "CONTRIBUTING.md",
      "IMPORT_MANIFEST.yaml",
      "LICENSE",
      "MIGRATION_MATRIX.md",
      "README.md",
      "ROADMAP.md",
      "SECURITY.md",
      "cucumber.mjs",
      "package-lock.json",
      "package.json"
    ],
    "deny": [],
    "allowedDirectories": [
      ".pi",
      ".dev-pomogator",
      ".github",
      ".omp",
      ".omp-plugin",
      ".specs",
      ".tmp",
      "audit-reports",
      "docs",
      "node_modules",
      "plugins",
      "scripts",
      "src",
      "tests"
    ],
    "ignorePatterns": [],
    "trashPatterns": [],
    "configPatterns": [],
    "autoPrune": {
      "enabled": false
    }
  }
}
