{
  "specsRepo": "https://github.com/stgmt/spec-database.git",
  "branch": "main",
  "projects": [
    { "id": "stgmt/omp-spec-kit" }
  ],
  "tenants": [
    {
      "tenant": "stgmt",
      "projects": ["stgmt/omp-spec-kit"],
      "hubGroups": ["spec-stgmt"],
      "defaultProject": "stgmt/omp-spec-kit"
    }
  ],
  "auth": {
    "youtrack": {
      "baseUrl": "https://youtrack.example.com",
      "serviceToken": "<service-account permanent token: reads users/groups for verification>"
    },
    "appBridge": {
      "token": "<secret shared with the YouTrack app; app settings hold the same value>"
    },
    "roleGroups": {
      "owner": ["spec-owners"],
      "writer": ["spec-writers"],
      "reader": ["spec-readers"]
    }
  },
  "repoPolicy": {
    "allowedHosts": ["github.com"]
  },
  "idpPolicy": {
    "allowedHosts": []
  },
  "publicUrl": "https://spec-registryd.example.com"
}
