# Secrets and local environment
.env
.env.*
!.env.example
*.pem
*.key
# `install-host` writes a project-scoped Claude config; never commit it.
/.mcp.json
/.mcp.json.bak
# The per-workspace project selection record written by `install-host`.
/.omp-spec-kit/project.json

# Dependencies and generated output
node_modules/
dist/
!plugins/omp-spec-kit/dist/
!plugins/omp-spec-kit/dist/**
!tests/fixtures/kernel/v0.3.0/
!tests/fixtures/kernel/v0.3.0/**
build/
coverage/
# release-candidate app staging is rebuilt by create-release-candidate.mjs;
# never commit an extracted package (it can carry an old extension point).
release-candidate/spec-graph-app/
.tmp/
tmp/
.cache/

# Logs, test evidence, and mutable state
*.log
*.ndjson
!tests/fixtures/evidence/
!tests/fixtures/evidence/*.ndjson
*.sqlite
*.sqlite3
.dev-*/
.test-results*
.progress.json
.omp/

# Python bytecode from local tooling scripts
__pycache__/
*.pyc

# Editor and operating-system state
.vscode/
.idea/
.DS_Store
Thumbs.db

# live E2E artifacts (contain tokens, dbs, screenshots)
tests/e2e/artifacts/
# context-mode per-process session stats (transient)
.github/context-mode/sessions/stats-pid-*.json
# release-preflight artifacts: regenerated from the tagged commit, never committed
tests/fixtures/release-candidate/candidate.json
tests/fixtures/release-candidate/*.tar
tests/fixtures/release-candidate/*.zip
tests/fixtures/release-candidate/spec-graph-app/
